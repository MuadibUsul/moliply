# ============================================================================
# MOLIPLY 模力补给 · 环境变量模板
# 复制为 .env 后填写。生产环境务必替换所有 CHANGE_ME 值。
# ============================================================================

APP_ENV=development
DEBUG=true
APP_NAME=MOLIPLY Auto-Recharge Gateway

# ---------------------------------------------------------------------------
# 品牌常量（前端通过 /api/v1/brand 读取，也可直接改前端 src/config/brand.ts）
# ---------------------------------------------------------------------------
BRAND_NAME_EN=MOLIPLY
BRAND_NAME_CN=模力补给
BRAND_SUBTITLE=AI 会员 · 软件订阅 · 数字商品
BRAND_HERO_SLOGAN=让优质数字服务，触手可及。
BRAND_CODE_PREFIX=MOLI
BRAND_THEME_BG=#0B0F19
BRAND_THEME_PRIMARY=#2563EB
BRAND_THEME_ACCENT=#06B6D4

# ---------------------------------------------------------------------------
# 对外地址（Docker 通过 Nginx 80 端口暴露；本地 npm dev 时改为 :3000 或 :3100）
# 上线改为 https://shop.moliply.com / https://up.moliply.com
# ---------------------------------------------------------------------------
PUBLIC_STORE_URL=http://localhost
PUBLIC_REDEEM_URL=http://localhost/redeem
API_BASE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost,http://localhost:3000,http://127.0.0.1:3000,https://shop.moliply.com,https://up.moliply.com

# ---------------------------------------------------------------------------
# 数据库 / Redis（Docker Compose 默认值；本地直接跑可用 sqlite:///./moliply.db）
# ---------------------------------------------------------------------------
# 主机端口映射（被占用时修改；商城统一经 Nginx 的 HTTP_PORT 访问）
HTTP_PORT=80
API_PORT=8000

POSTGRES_DB=moliply
POSTGRES_USER=moliply
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD
DATABASE_URL=postgresql+psycopg2://moliply:CHANGE_ME_DB_PASSWORD@db:5432/moliply
REDIS_URL=redis://redis:6379/0
TASK_MODE=celery
# SEED_DEMO_DATA 初始化演示商品目录（仅当商品表为空时执行）
# SEED_DEMO_INVENTORY 还会生成假卡密/假成品号演示库存 + 演示优惠码
# 正式上线：SEED_DEMO_DATA=true 首次建目录后改为 false；SEED_DEMO_INVENTORY 必须为 false
SEED_DEMO_DATA=true
SEED_DEMO_INVENTORY=true

# ---------------------------------------------------------------------------
# 安全（上线必须更换；MASTER_AES_KEY 必须是 base64 编码的 32 字节随机值）
# 生成命令：
#   python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
# ---------------------------------------------------------------------------
SECRET_KEY=CHANGE_ME_RANDOM_SECRET
MASTER_AES_KEY=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
ADMIN_JWT_SECRET=CHANGE_ME_RANDOM_JWT_SECRET
ADMIN_TOKEN_TTL_MINUTES=720
# 客户订单账户令牌（邮箱+密码登录订单中心）；留空时回退到 SECRET_KEY
USER_JWT_SECRET=
USER_TOKEN_TTL_DAYS=30
LOGIN_RATE_LIMIT=10/minute
TOKEN_RETENTION_MINUTES=5
MAX_SESSION_BYTES=262144

# 接口限流
REDEEM_RATE_LIMIT=10/minute
ADMIN_LOGIN_RATE_LIMIT=10/minute
LOOKUP_RATE_LIMIT=30/minute
FAILED_CODE_LIMIT=5
FAILED_CODE_WINDOW_MINUTES=30

# ---------------------------------------------------------------------------
# 支付通道
# PAYMENT_MODE=mock 为本地演示；上线改为 live 并填写蓝兔/虎皮椒参数
# ---------------------------------------------------------------------------
PAYMENT_MODE=mock
MOCK_PAYMENT_ENABLED=true
ORDER_EXPIRE_MINUTES=15
ENFORCE_STOCK=true

# 蓝兔支付（微信 + 支付宝个人小微商户）
LTZF_MCH_ID=
LTZF_APP_ID=
LTZF_KEY=
LTZF_API_BASE=https://api.ltzf.cn
LTZF_NOTIFY_URL=https://shop.moliply.com/api/v1/payments/ltzf/notify

# 虎皮椒支付 V3
XUNHUPAY_APP_ID=
XUNHUPAY_APP_SECRET=
XUNHUPAY_API_BASE=https://api.xunhupay.com
XUNHUPAY_NOTIFY_URL=https://shop.moliply.com/api/v1/payments/xunhupay/notify
XUNHUPAY_RETURN_URL=https://shop.moliply.com/orders

# 加密货币收款（NOWPayments：USDT / USDC / BTC / ETH）
# 在 NOWPayments 商户后台开启对应币种，并配置 IPN：
# https://moliply.shop/api/v1/payments/nowpayments/ipn
CRYPTO_ENABLED=false
CRYPTO_PROVIDER=nowpayments
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
NOWPAYMENTS_API_BASE=https://api.nowpayments.io
NOWPAYMENTS_IPN_URL=https://moliply.shop/api/v1/payments/nowpayments/ipn
CRYPTO_CNY_PER_USD=7.20
CRYPTO_SUPPORTED_COINS=USDT,USDC,BTC,ETH

# 飞书管理通知（也可在后台系统设置中配置）
FEISHU_ENABLED=false
FEISHU_WEBHOOK_URL=
FEISHU_SECRET=
FEISHU_LOW_STOCK_THRESHOLD=5
FEISHU_MENTION_ALL=false

# ---------------------------------------------------------------------------
# 上游代充 API（通道 1）
# 拿货供应商提供 API 时填写。UPSTREAM_MODE=mock 为本地演示。
# 签名/字段如与供应商文档不同，只需修改 app/services/upstream_provider.py。
# ---------------------------------------------------------------------------
UPSTREAM_MODE=mock
UPSTREAM_API_BASE=
UPSTREAM_API_KEY=
UPSTREAM_API_SECRET=
UPSTREAM_MOCK_DELAY_SECONDS=2
UPSTREAM_MOCK_FAIL_RATE=0
UPSTREAM_MAX_WAIT_SECONDS=180
UPSTREAM_POLL_INTERVAL_SECONDS=5

# ---------------------------------------------------------------------------
# OpenAI 账号状态预检（可选）
# 开启后需要美国纯净住宅代理；失败策略默认 fail-open，避免代理故障阻断销售。
# ---------------------------------------------------------------------------
OPENAI_ACCOUNT_CHECK_ENABLED=false
OPENAI_ACCOUNT_CHECK_FAIL_OPEN=true
OPENAI_API_BASE=https://chatgpt.com
OPENAI_PROXY_URL=

# ---------------------------------------------------------------------------
# 自营 RDVCC 卡池（通道 2）
# 默认关闭 + 演练模式。开启前必须配置美国住宅代理、邮箱 IMAP 与账单地址。
# ---------------------------------------------------------------------------
SELF_VCC_ENABLED=false
SELF_VCC_DRY_RUN=true
SELF_VCC_HEADLESS=true
SELF_VCC_MIN_BALANCE=22
SELF_VCC_TIMEOUT_SECONDS=150
SELF_VCC_CANCEL_AUTORENEW=true
# HYBRID_SELF_FIRST | SELF_VCC_ONLY | UPSTREAM_ONLY
ROUTING_POLICY=HYBRID_SELF_FIRST
# 卡池调度阈值与成本（美元）；金额单位分别为 PHP / USD
SELF_VCC_PH_MIN_BALANCE=18.5
SELF_VCC_US_MIN_BALANCE=22
PH_PLUS_AMOUNT_PHP=999
PH_PRO_20X_AMOUNT_PHP=9990
US_PLUS_AMOUNT_USD=20
US_PRO_20X_AMOUNT_USD=200
PH_PLUS_COST_USD=16.7
US_PLUS_COST_USD=20.9
# 优先用于 ₱999 菲律宾结账的住宅代理；美区代理留空时回退 PROXY_URL
PH_RESIDENTIAL_PROXY_URL=
US_RESIDENTIAL_PROXY_URL=
PROXY_URL=
PROXY_HEALTH_URL=https://ipinfo.io/json
PROXY_REQUIRED_COUNTRY=US
# 可选：录入卡片时强制校验 BIN 前 6 位（逗号分隔，例如 424242,428837）
US_BIN_ALLOWLIST=
RDVCC_CHECKOUT_URL_TEMPLATE=

# RDVCC 3DS 验证码邮箱（IMAP）
RDVCC_IMAP_HOST=
RDVCC_IMAP_PORT=993
RDVCC_IMAP_USER=
RDVCC_IMAP_PASSWORD=
RDVCC_3DS_SENDER=rdvcc
RDVCC_3DS_CODE_REGEX='\b(\d{6})\b'
RDVCC_3DS_CODE_WINDOW_SECONDS=90

# ---------------------------------------------------------------------------
# 发货邮件（可选，未配置则只在订单页展示）
# ---------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=MOLIPLY 模力补给 <no-reply@moliply.com>
SMTP_USE_SSL=true

# ---------------------------------------------------------------------------
# 前端展示（NEXT_PUBLIC_ 前缀会打进浏览器包，禁止放密钥）
# ---------------------------------------------------------------------------
NEXT_PUBLIC_STORE_URL=http://localhost
NEXT_PUBLIC_REDEEM_URL=http://localhost/redeem
SUPPORT_WECHAT=MOLIPLY-SUPPORT
SUPPORT_HOURS=每日 09:00–24:00
NEXT_PUBLIC_CONTACT_WECHAT=MOLIPLY-SUPPORT
NEXT_PUBLIC_API_BASE_URL=
