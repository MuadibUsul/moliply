FULFILL_MODE=manual          # manual | stock | supplier
LOG_LEVEL=INFO
REPLAY_WINDOW_SECONDS=300
IDEMPOTENCY_TTL_SECONDS=86400
# MAX_PENDING_PER_SKU=20

# generated on the server, must match MOLIPLY's 上游 settings
UPSTREAM_KEY=
UPSTREAM_SECRET=
# guards /admin; open http://127.0.0.1:18099/admin locally
UPSTREAM_ADMIN_TOKEN=

# --- supplier 模式（全自动，无人值守）---
# 买货与核销都调上游 API。SUPPLIER 现在只支持 yunshu。
SUPPLIER=yunshu
YUNSHU_API_BASE=https://yunshutoken.com/partner/v1
YUNSHU_TOKEN=
# 本地 SKU=上游商品编号，逗号分隔
YUNSHU_SKU_MAP=CHATGPT_PLUS_1M=,CLAUDE_PRO_1M=
# 可选：上游要求的区服/规格
YUNSHU_RACE=
YUNSHU_SKU=
